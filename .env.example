# YNAB API configuration
#
# Recommended: keep the token out of plaintext files and store it in the OS keychain:
#   ynab auth set ynab                 (hidden prompt; or pipe it with --stdin)
#   ynab auth migrate                  (copies a YNAB_API_KEY from .env into the keychain)
# A value set here still overrides the keychain, so delete the line after migrating.
YNAB_API_KEY=
YNAB_BASE_URL=https://api.ynab.com/v1

# Optional: set a default budget ID so you don't need --budget-id on every call
YNAB_BUDGET_ID=

# Optional: set to 0 to never read the OS keychain (CI, headless Linux without a Secret Service)
# YNAB_KEYCHAIN=0
